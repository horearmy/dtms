generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id        String    @id
  tenantId  String
  name      String
  keyHash   String    @unique
  keyPrefix String
  scopes    String[]
  active    Boolean   @default(true)
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id        String   @id
  userId    String?
  action    String
  module    String
  oldData   String?
  newData   String?
  createdAt DateTime @default(now())
  ip        String?
  method    String?
  path      String?
  userAgent String?
  tenantId  String?
  Tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([module])
  @@index([tenantId])
  @@index([userId])
}

model Branch {
  id             String        @id
  tenantId       String
  companyId      String?
  name           String
  code           String?
  address        String?
  city           String?
  postalCode     String?
  phone          String?
  latitude       Float?
  longitude      Float?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  organizationId String?
  regionId       String?
  Company        Company?      @relation(fields: [companyId], references: [id])
  Organization   Organization? @relation(fields: [organizationId], references: [id])
  Region         Region?       @relation(fields: [regionId], references: [id])
  Tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Department     Department[]
  Hub            Hub[]
  User           User[]
  Warehouse      Warehouse[]

  @@unique([tenantId, code])
  @@index([companyId])
  @@index([organizationId])
  @@index([regionId])
  @@index([tenantId])
}

model Company {
  id         String       @id
  tenantId   String
  name       String
  code       String?
  address    String?
  city       String?
  postalCode String?
  phone      String?
  email      String?
  latitude   Float?
  longitude  Float?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  Branch     Branch[]
  Tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Department Department[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Customer {
  id                                     String         @id
  name                                   String
  phone                                  String
  email                                  String?
  address                                String?
  city                                   String?
  postalCode                             String?
  createdAt                              DateTime       @default(now())
  latitude                               Float?
  longitude                              Float?
  tenantId                               String?
  Tenant                                 Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Shipment_Shipment_receiverIdToCustomer Shipment[]     @relation("Shipment_receiverIdToCustomer")
  Shipment_Shipment_senderIdToCustomer   Shipment[]     @relation("Shipment_senderIdToCustomer")
  ShipmentStop                           ShipmentStop[]

  @@index([tenantId])
}

model DailyReport {
  id               String   @id
  driverId         String
  reportDate       DateTime
  deliveredCount   Int      @default(0)
  failedCount      Int      @default(0)
  rescheduledCount Int      @default(0)
  fuelLiter        Float?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  Driver           Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, reportDate])
  @@index([reportDate])
}

model DeliveryAssignment {
  id         String   @id
  shipmentId String
  driverId   String
  vehicleId  String?
  assignedAt DateTime @default(now())
  Driver     Driver   @relation(fields: [driverId], references: [id])
  Shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  Vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([driverId, assignedAt])
  @@index([shipmentId])
  @@index([vehicleId])
}

model DemoRequest {
  id            String    @id
  name          String
  email         String
  phone         String?
  company       String
  message       String?
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  provisionedAt DateTime?
  tenantId      String?
  Tenant        Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([createdAt])
  @@index([status])
}

model Department {
  id        String   @id
  tenantId  String
  companyId String?
  name      String
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  branchId  String?
  updatedAt DateTime
  Branch    Branch?  @relation(fields: [branchId], references: [id])
  Company   Company? @relation(fields: [companyId], references: [id])
  Tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([companyId])
  @@index([tenantId])
}

model Driver {
  id                 String               @id
  employeeId         String               @unique
  name               String
  phone              String
  userId             String?              @unique
  status             DriverStatus         @default(ACTIVE)
  returnedAt         DateTime?
  returning          Boolean              @default(false)
  photo              String?
  returnStartedAt    DateTime?
  tenantId           String?
  DailyReport        DailyReport[]
  DeliveryAssignment DeliveryAssignment[]
  Tenant             Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User               User?                @relation(fields: [userId], references: [id])
  GeofenceEvent      GeofenceEvent[]
  GpsLog             GpsLog[]

  @@index([tenantId])
}

model Exception {
  id          String            @id
  tenantId    String
  shipmentId  String?
  type        ExceptionType
  severity    ExceptionSeverity @default(MEDIUM)
  status      ExceptionStatus   @default(OPEN)
  title       String
  description String?
  ownerId     String?
  dueAt       DateTime?
  resolvedAt  DateTime?
  resolution  String?
  createdBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime
  User        User?             @relation(fields: [ownerId], references: [id])
  Shipment    Shipment?         @relation(fields: [shipmentId], references: [id])
  Tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([severity])
  @@index([shipmentId])
  @@index([status])
  @@index([tenantId])
}

model Geofence {
  id            String          @id
  name          String
  latitude      Float
  longitude     Float
  radiusMeters  Float           @default(500)
  type          GeofenceType    @default(OPERATIONAL_AREA)
  description   String?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  tenantId      String?
  Tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  GeofenceEvent GeofenceEvent[]

  @@index([tenantId])
}

model GeofenceEvent {
  id         String            @id
  geofenceId String
  driverId   String
  shipmentId String?
  eventType  GeofenceEventType
  latitude   Float
  longitude  Float
  createdAt  DateTime          @default(now())
  Driver     Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  Geofence   Geofence          @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@index([geofenceId, driverId])
}

model GpsLog {
  id        String   @id
  driverId  String
  vehicleId String?
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  accuracy  Float?
  battery   Float?
  createdAt DateTime @default(now())
  Driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  Vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([createdAt])
  @@index([driverId, createdAt])
  @@index([vehicleId])
}

model Hub {
  id           String   @id
  tenantId     String
  branchId     String
  name         String
  code         String?
  address      String?
  city         String?
  latitude     Float?
  longitude    Float?
  radiusMeters Float    @default(500)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  Branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([branchId])
  @@index([tenantId])
}

model IntegrationConfig {
  id                  String                @id
  tenantId            String
  name                String
  type                IntegrationType
  baseUrl             String?
  active              Boolean               @default(true)
  config              Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  Tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  IntegrationLog      IntegrationLog[]
  WebhookSubscription WebhookSubscription[]

  @@index([tenantId])
}

model IntegrationLog {
  id                String            @id
  integrationId     String
  direction         String
  method            String?
  path              String?
  statusCode        Int?
  request           Json?
  response          Json?
  error             String?
  durationMs        Int?
  createdAt         DateTime          @default(now())
  IntegrationConfig IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
}

model Invoice {
  id                 String       @id
  tenantId           String
  subscriptionId     String
  invoiceNumber      String       @unique
  status             String       @default("DRAFT")
  subtotal           Float        @default(0)
  tax                Float        @default(0)
  total              Float        @default(0)
  currency           String       @default("IDR")
  dueDate            DateTime
  paidAt             DateTime?
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  lineItems          Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime
  Subscription       Subscription @relation(fields: [subscriptionId], references: [id])
  Tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Payment            Payment[]

  @@index([status])
  @@index([tenantId])
}

model LoginAttempt {
  id        String   @id
  username  String
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([username, createdAt])
}

model Message {
  id         String   @id
  tenantId   String
  threadId   String?
  subject    String
  body       String
  senderId   String?
  senderName String   @default("System")
  direction  String   @default("OUTBOUND")
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  Tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([threadId])
}

model Notification {
  id         String    @id
  userId     String?
  shipmentId String?
  message    String
  status     String    @default("UNREAD")
  createdAt  DateTime  @default(now())
  metadata   Json?
  tenantId   String?
  title      String?
  type       String    @default("INFO")
  Shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  Tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model Organization {
  id          String   @id
  tenantId    String
  name        String
  code        String?
  description String?
  logoUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Branch      Branch[]
  Tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Region      Region[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  token     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([token])
  @@index([userId])
}

model Payment {
  id        String    @id
  tenantId  String
  invoiceId String
  amount    Float
  currency  String    @default("IDR")
  method    String?
  reference String?
  status    String    @default("PENDING")
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Invoice   Invoice   @relation(fields: [invoiceId], references: [id])
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Permission {
  id             String           @id
  code           String           @unique
  resource       String
  action         String
  label          String?
  createdAt      DateTime         @default(now())
  RolePermission RolePermission[]

  @@index([resource])
}

model Plan {
  id                String         @id
  name              String
  code              String         @unique
  description       String?
  priceMonthly      Float          @default(0)
  priceYearly       Float          @default(0)
  currency          String         @default("IDR")
  maxUsers          Int            @default(5)
  maxDrivers        Int            @default(10)
  maxShipments      Int            @default(100)
  maxStorageMb      Int            @default(100)
  features          Json?
  active            Boolean        @default(true)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  maxApiCallsPerMin Int            @default(0)
  maxBranches       Int            @default(1)
  maxHubs           Int            @default(0)
  maxOrganizations  Int            @default(1)
  trialDays         Int            @default(0)
  Subscription      Subscription[]
}

model PlanAddon {
  id           String        @id
  name         String
  slug         String        @unique
  description  String?
  priceMonthly Float         @default(0)
  features     Json?
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  TenantAddon  TenantAddon[]
}

model ProofOfDelivery {
  id           String   @id
  shipmentId   String   @unique
  receiverName String
  signature    String?
  photo        String?
  latitude     Float?
  longitude    Float?
  notes        String?
  deliveredAt  DateTime @default(now())
  Shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Region {
  id             String        @id
  tenantId       String
  organizationId String?
  name           String
  code           String?
  description    String?
  latitude       Float?
  longitude      Float?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  Branch         Branch[]
  Organization   Organization? @relation(fields: [organizationId], references: [id])
  Tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([organizationId])
  @@index([tenantId])
}

model RolePermission {
  id           String     @id
  permissionId String
  role         Role
  tenantId     String?
  branchId     String?
  createdAt    DateTime   @default(now())
  Permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  Tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([permissionId, role, tenantId])
  @@index([role])
  @@index([tenantId])
}

model Shipment {
  id                                     String               @id
  trackingNumber                         String               @unique
  senderId                               String
  receiverId                             String
  origin                                 String
  destination                            String
  weight                                 Float
  volume                                 Float?
  serviceType                            ServiceType          @default(REGULAR)
  status                                 ShipmentStatus       @default(ORDER_CREATED)
  fragile                                Boolean              @default(false)
  itemName                               String?
  itemCount                              Int                  @default(1)
  itemCategory                           String?
  itemValue                              Float?
  deliveryTarget                         DateTime?
  createdAt                              DateTime             @default(now())
  updatedAt                              DateTime
  destLat                                Float?
  destLng                                Float?
  originLat                              Float?
  originLng                              Float?
  slaDeadline                            DateTime?
  tenantId                               String?
  DeliveryAssignment                     DeliveryAssignment[]
  Exception                              Exception[]
  Notification                           Notification[]
  ProofOfDelivery                        ProofOfDelivery?
  Customer_Shipment_receiverIdToCustomer Customer             @relation("Shipment_receiverIdToCustomer", fields: [receiverId], references: [id])
  Customer_Shipment_senderIdToCustomer   Customer             @relation("Shipment_senderIdToCustomer", fields: [senderId], references: [id])
  Tenant                                 Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ShipmentEvent                          ShipmentEvent[]
  ShipmentItem                           ShipmentItem[]
  ShipmentStop                           ShipmentStop[]
  SlaEvent                               SlaEvent[]
  TrackingEvent                          TrackingEvent[]
  WarehouseScan                          WarehouseScan[]

  @@index([createdAt])
  @@index([receiverId])
  @@index([senderId])
  @@index([status])
  @@index([tenantId])
}

model ShipmentEvent {
  id             String            @id
  tenantId       String?
  shipmentId     String
  eventType      ShipmentEventType
  previousStatus ShipmentStatus?
  newStatus      ShipmentStatus?
  actorType      String?
  actorId        String?
  metadata       String?
  latitude       Float?
  longitude      Float?
  occurredAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())
  Shipment       Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  Tenant         Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([shipmentId])
  @@index([tenantId])
}

model ShipmentItem {
  id         String   @id
  shipmentId String
  itemName   String
  quantity   Int
  weight     Float?
  dimension  String?
  Shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ShipmentStop {
  id         String    @id
  shipmentId String
  seq        Int
  customerId String?
  label      String
  address    String?
  city       String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  Customer   Customer? @relation(fields: [customerId], references: [id])
  Shipment   Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model SlaEvent {
  id         String     @id
  tenantId   String
  shipmentId String
  policyId   String?
  status     String     @default("ON_TRACK")
  deadline   DateTime
  breachedAt DateTime?
  createdAt  DateTime   @default(now())
  SlaPolicy  SlaPolicy? @relation(fields: [policyId], references: [id])
  Shipment   Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  Tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([status])
  @@index([tenantId])
}

model SlaPolicy {
  id          String      @id
  tenantId    String
  name        String
  serviceType ServiceType @default(REGULAR)
  originCity  String?
  destCity    String?
  priority    Int         @default(0)
  targetHours Int
  cutoffTime  String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  SlaEvent    SlaEvent[]
  Tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, serviceType])
}

model Subscription {
  id                 String        @id
  tenantId           String        @unique
  planId             String
  status             String        @default("ACTIVE")
  billingCycle       String        @default("MONTHLY")
  startDate          DateTime      @default(now())
  currentPeriodStart DateTime      @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime
  Invoice            Invoice[]
  Plan               Plan          @relation(fields: [planId], references: [id])
  Tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  UsageRecord        UsageRecord[]
}

model Tenant {
  id                  String                @id
  name                String
  slug                String                @unique
  logoUrl             String?
  faviconUrl          String?
  primaryColor        String                @default("#2563eb")
  secondaryColor      String                @default("#1e40af")
  accentColor         String                @default("#3b82f6")
  domain              String?               @unique
  plan                String                @default("FREE")
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  maxUsers            Int                   @default(5)
  maxDrivers          Int                   @default(10)
  maxShipments        Int                   @default(100)
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  code                String?               @unique
  currency            String                @default("IDR")
  locale              String                @default("id-ID")
  status              TenantStatus          @default(ACTIVE)
  timezone            String                @default("Asia/Jakarta")
  maxBranches         Int                   @default(1)
  maxHubs             Int                   @default(0)
  maxOrganizations    Int                   @default(1)
  maxStorageMb        Int                   @default(50)
  ApiKey              ApiKey[]
  AuditLog            AuditLog[]
  Branch              Branch[]
  Company             Company[]
  Customer            Customer[]
  DemoRequest         DemoRequest[]
  Department          Department[]
  Driver              Driver[]
  Exception           Exception[]
  Geofence            Geofence[]
  Hub                 Hub[]
  IntegrationConfig   IntegrationConfig[]
  Invoice             Invoice[]
  Message             Message[]
  Notification        Notification[]
  Organization        Organization[]
  Payment             Payment[]
  Region              Region[]
  RolePermission      RolePermission[]
  Shipment            Shipment[]
  ShipmentEvent       ShipmentEvent[]
  SlaEvent            SlaEvent[]
  SlaPolicy           SlaPolicy[]
  Subscription        Subscription?
  TenantAddon         TenantAddon[]
  TenantHealthMetric  TenantHealthMetric[]
  TenantOnboarding    TenantOnboarding[]
  TenantRateLimit     TenantRateLimit?
  UploadedFile        UploadedFile[]
  UsageRecord         UsageRecord[]
  User                User[]
  Vehicle             Vehicle[]
  Warehouse           Warehouse[]
  WebhookSubscription WebhookSubscription[]
  WhiteLabel          WhiteLabel?

  @@index([code])
  @@index([domain])
  @@index([slug])
  @@index([status])
}

model TenantAddon {
  id        String    @id
  tenantId  String
  addonId   String
  quantity  Int       @default(1)
  startDate DateTime  @default(now())
  endDate   DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  PlanAddon PlanAddon @relation(fields: [addonId], references: [id])
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, addonId])
  @@index([tenantId])
}

model TenantHealthMetric {
  id         String   @id
  tenantId   String
  metricType String
  value      Float
  unit       String?
  period     String?
  recordedAt DateTime @default(now())
  Tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, metricType])
  @@index([tenantId, metricType, recordedAt])
}

model TenantOnboarding {
  id          String           @id
  tenantId    String
  step        String
  label       String
  description String?
  status      OnboardingStatus @default(PENDING)
  order       Int              @default(0)
  completedAt DateTime?
  data        Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  Tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, step])
  @@index([tenantId])
}

model TenantRateLimit {
  id             String   @id
  tenantId       String   @unique
  apiMaxRequests Int      @default(300)
  apiWindowMs    Int      @default(60000)
  gpsMaxRequests Int      @default(60)
  gpsWindowMs    Int      @default(60000)
  active         Boolean  @default(true)
  blocked        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  Tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TrackingEvent {
  id         String         @id
  shipmentId String
  status     ShipmentStatus
  latitude   Float?
  longitude  Float?
  notes      String?
  createdBy  String?
  createdAt  DateTime       @default(now())
  Shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model UploadedFile {
  id           String   @id
  tenantId     String?
  objectKey    String   @unique
  fileName     String
  mimeType     String
  size         Int
  checksum     String?
  uploadedById String?
  category     String   @default("general")
  shipmentId   String?
  createdAt    DateTime @default(now())
  Tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([objectKey])
  @@index([shipmentId])
  @@index([tenantId])
}

model UsageRecord {
  id             String       @id
  tenantId       String
  subscriptionId String
  metric         String
  quantity       Int          @default(0)
  recordedAt     DateTime     @default(now())
  periodStart    DateTime
  periodEnd      DateTime
  Subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  Tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId, metric])
}

model User {
  id                 String               @id
  name               String
  username           String
  passwordHash       String
  role               Role
  status             UserStatus           @default(ACTIVE)
  phone              String?
  createdAt          DateTime             @default(now())
  lastPasswordChange DateTime?
  mustChangePassword Boolean              @default(false)
  pwdVersion         Int                  @default(1)
  backupCodes        String?
  email              String?
  provider           String               @default("LOCAL")
  totpEnabled        Boolean              @default(false)
  totpSecret         String?
  tenantId           String?
  branchId           String?
  AuditLog           AuditLog[]
  Driver             Driver?
  Exception          Exception[]
  Notification       Notification[]
  PasswordResetToken PasswordResetToken[]
  Branch             Branch?              @relation(fields: [branchId], references: [id])
  Tenant             Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, username])
  @@index([branchId])
  @@index([tenantId])
}

model Vehicle {
  id                 String               @id
  vehicleNumber      String               @unique
  type               String
  capacity           Float                @default(0)
  status             String               @default("AVAILABLE")
  photoBack          String?
  photoFront         String?
  photoLeft          String?
  photoRight         String?
  totalDistanceKm    Float                @default(0)
  returnedAt         DateTime?
  returning          Boolean              @default(false)
  tenantId           String?
  DeliveryAssignment DeliveryAssignment[]
  GpsLog             GpsLog[]
  Tenant             Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  VehicleMaintenance VehicleMaintenance[]

  @@index([tenantId])
}

model VehicleMaintenance {
  id          String   @id
  vehicleId   String
  type        String
  description String?
  cost        Float?
  odometerKm  Float?
  notes       String?
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  Vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, performedAt])
}

model Warehouse {
  id           String   @id
  tenantId     String
  branchId     String?
  name         String
  code         String?
  address      String?
  city         String?
  latitude     Float?
  longitude    Float?
  radiusMeters Float    @default(500)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  Branch       Branch?  @relation(fields: [branchId], references: [id])
  Tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([branchId])
  @@index([tenantId])
}

model WarehouseScan {
  id         String   @id
  shipmentId String
  action     String
  scannedBy  String?
  latitude   Float?
  longitude  Float?
  notes      String?
  createdAt  DateTime @default(now())
  Shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model WebhookDelivery {
  id                  String              @id
  subscriptionId      String
  event               String
  payload             Json
  statusCode          Int?
  responseBody        String?
  attempt             Int                 @default(0)
  maxAttempts         Int                 @default(3)
  status              String              @default("PENDING")
  nextRetryAt         DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime            @default(now())
  WebhookSubscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([subscriptionId])
}

model WebhookSubscription {
  id                String             @id
  tenantId          String
  integrationId     String?
  url               String
  events            String[]
  secret            String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  WebhookDelivery   WebhookDelivery[]
  IntegrationConfig IntegrationConfig? @relation(fields: [integrationId], references: [id])
  Tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model WhiteLabel {
  id               String   @id
  tenantId         String   @unique
  appName          String?
  logoUrl          String?
  faviconUrl       String?
  primaryColor     String?
  secondaryColor   String?
  accentColor      String?
  loginBgUrl       String?
  emailFromName    String?
  emailFromAddress String?
  emailTemplate    Json?
  smsProvider      String?
  smsConfig        Json?
  customCss        String?
  customDomain     String?
  landingPageHtml  String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  Tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

