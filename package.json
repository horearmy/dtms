    "alerts:scheduler": "node scripts/alert-scheduler.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@sentry/nextjs": "^10.70.0",
    "bcryptjs": "^2.4.3",
