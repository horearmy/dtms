generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#2563eb")
  secondaryColor  String   @default("#1e40af")
  accentColor     String   @default("#3b82f6")
  domain          String?  @unique
  plan            String   @default("FREE")
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  maxUsers        Int      @default(5)
  maxDrivers      Int      @default(10)
  maxShipments    Int      @default(100)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]
  customers       Customer[]
  shipments       Shipment[]
  drivers         Driver[]
  vehicles        Vehicle[]
  geofences       Geofence[]

  @@index([slug])
  @@index([domain])
}

enum Role {
  SUPER_ADMIN
  ADMIN_OPERASIONAL
  DISPATCHER
  WAREHOUSE
  DRIVER
  CUSTOMER_SERVICE
  SUPERVISOR
  MANAGEMENT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum ShipmentStatus {
  ORDER_CREATED
  PICKUP_SCHEDULED
  PICKED_UP
  WAREHOUSE_RECEIVED
  SORTING
  DISPATCHED
  IN_TRANSIT
  ARRIVED_AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RESCHEDULED
  RETURN_TO_SENDER
  RETURNED
}

enum ServiceType {
  SAME_DAY
  NEXT_DAY
  REGULAR
}

enum GeofenceType {
  WAREHOUSE
  HUB
  OPERATIONAL_AREA
  DESTINATION
}

enum GeofenceEventType {
  ENTER
  EXIT
}

model User {
  id                 String         @id @default(cuid())
  tenantId           String?
  tenant             Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  username           String         @unique
  passwordHash       String
  email              String?        @unique
  provider           String         @default("LOCAL")
  role               Role
  status             UserStatus     @default(ACTIVE)
  phone              String?
  pwdVersion         Int            @default(1)
  mustChangePassword Boolean        @default(false)
  lastPasswordChange DateTime?
  totpSecret         String?
  totpEnabled        Boolean        @default(false)
  backupCodes        String?
  createdAt          DateTime       @default(now())
  driver             Driver?
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([tenantId])
  @@index([tenantId, username])
}

model Customer {
  id         String  @id @default(cuid())
  tenantId   String?
  tenant     Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  email      String?
  address    String?
  city       String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  sentBy     Shipment[] @relation("sender")
  receivedBy Shipment[] @relation("receiver")
  stopsShipped ShipmentStop[] @relation("customerStop")

  @@index([tenantId])
}

model Shipment {
  id             String        @id @default(cuid())
  tenantId       String?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trackingNumber String        @unique
  senderId       String
  receiverId     String
  sender         Customer      @relation("sender", fields: [senderId], references: [id])
  receiver       Customer      @relation("receiver", fields: [receiverId], references: [id])
  origin         String
  destination    String
  originLat      Float?
  originLng      Float?
  destLat        Float?
  destLng        Float?
  weight         Float
  volume         Float?
  serviceType    ServiceType   @default(REGULAR)
  status         ShipmentStatus @default(ORDER_CREATED)
  fragile        Boolean       @default(false)
  itemName       String?
  itemCount      Int           @default(1)
  itemCategory   String?
  itemValue      Float?
  slaDeadline    DateTime?
  deliveryTarget DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          ShipmentItem[]
  assignments    DeliveryAssignment[]
  events         TrackingEvent[]
  pods           ProofOfDelivery[]
  notifications  Notification[]
  stops          ShipmentStop[]
  scans          WarehouseScan[]

  @@index([tenantId])
}

model ShipmentStop {
  id         String    @id @default(cuid())
  shipmentId String
  shipment   Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  seq        Int
  customerId String?
  customer   Customer? @relation("customerStop", fields: [customerId], references: [id], onDelete: SetNull)
  label      String
  address    String?
  city       String?
  postalCode String?
  latitude   Float?
  longitude  Float?
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  itemName   String
  quantity   Int
  weight     Float?
  dimension  String?
}

model Driver {
  id             String        @id @default(cuid())
  tenantId       String?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId     String        @unique
  name           String
  phone          String
  photo          String?
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id])
  status         DriverStatus  @default(ACTIVE)
  returning      Boolean       @default(false)
  returnedAt     DateTime?
  returnStartedAt DateTime?
  assignments    DeliveryAssignment[]
  gpsLogs        GpsLog[]
  geofenceEvents GeofenceEvent[]
  dailyReports   DailyReport[]

  @@index([tenantId])
}

model Vehicle {
  id            String   @id @default(cuid())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicleNumber String   @unique
  type          String
  capacity      Float    @default(0)
  status        String   @default("AVAILABLE")
  totalDistanceKm Float  @default(0)
  photoFront    String?
  photoBack     String?
  photoRight    String?
  photoLeft     String?
  returning     Boolean @default(false)
  returnedAt    DateTime?
  assignments   DeliveryAssignment[]
  gpsLogs       GpsLog[]
  maintenanceRecords   VehicleMaintenance[]

  @@index([tenantId])
}

model VehicleMaintenance {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String
  description String?
  cost        Float?
  odometerKm  Float?
  notes       String?
  performedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([vehicleId, performedAt])
}

model DailyReport {
  id              String   @id @default(cuid())
  driverId        String
  driver          Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  reportDate      DateTime
  deliveredCount  Int      @default(0)
  failedCount     Int      @default(0)
  rescheduledCount Int     @default(0)
  fuelLiter       Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([driverId, reportDate])
  @@index([reportDate])
}

model DeliveryAssignment {
  id         String   @id @default(cuid())
  shipmentId String
  driverId   String
  vehicleId  String?
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  driver     Driver   @relation(fields: [driverId], references: [id])
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])
  assignedAt DateTime @default(now())
}

model TrackingEvent {
  id         String        @id @default(cuid())
  shipmentId String
  shipment   Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  latitude   Float?
  longitude  Float?
  notes      String?
  createdBy  String?
  createdAt  DateTime      @default(now())
}

model GpsLog {
  id        String   @id @default(cuid())
  driverId  String
  vehicleId String?
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  accuracy  Float?
  battery   Float?
  createdAt DateTime @default(now())
}

model ProofOfDelivery {
  id           String   @id @default(cuid())
  shipmentId   String   @unique
  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  receiverName String
  signature    String?
  photo        String?
  latitude     Float?
  longitude    Float?
  notes        String?
  deliveredAt  DateTime @default(now())
}

model Notification {
  id         String    @id @default(cuid())
  userId     String?
  shipmentId String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  message    String
  status     String    @default("UNREAD")
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  module    String
  oldData   String?
  newData   String?
  ip        String?
  method    String?
  path      String?
  userAgent String?
  createdAt DateTime @default(now())
}

model WarehouseScan {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  action     String
  scannedBy  String?
  latitude   Float?
  longitude  Float?
  notes      String?
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}

model Geofence {
  id           String          @id @default(cuid())
  tenantId     String?
  tenant       Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Float           @default(500)
  type         GeofenceType    @default(OPERATIONAL_AREA)
  description  String?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  events       GeofenceEvent[]

  @@index([tenantId])
}

model GeofenceEvent {
  id          String            @id @default(cuid())
  geofenceId  String
  geofence    Geofence          @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  driverId    String
  driver      Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  shipmentId  String?
  eventType   GeofenceEventType
  latitude    Float
  longitude   Float
  createdAt   DateTime          @default(now())

  @@index([geofenceId, driverId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

model DemoRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String
  message   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}