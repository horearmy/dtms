# ===== DTMS Environment Variables =====
# Salin file ini menjadi `.env` lalu isi nilainya.

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL="postgresql://dtms:PASSWORD@localhost:5432/dtms"

# --- Keamanan / Auth ---
# Secret untuk menandatangani JWT. WAJIB diubah menjadi string acak panjang.
AUTH_SECRET="ganti-dengan-secret-acak-panjang"

# Durasi sesi login dalam jam (opsional, default 12).
SESSION_HOURS="12"

# Admin awal (dibuat otomatis saat seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-admin-password"

# --- SSO Google (opsional) ---
# Buat OAuth Client ID di Google Cloud Console
# (https://console.cloud.google.com/apis/credentials) lalu isi:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Harus konsisten dgn redirect URI yang didaftarkan:
#   {APP_URL}/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# URL publik aplikasi, contoh: https://dtms.example.com (tanpa slash di akhir)
APP_URL=""

# --- Observability Sentry (opsional) ---
# DSN publik (ekspos di client) -> dipakai sentry.client.config.ts
NEXT_PUBLIC_SENTRY_DSN=""
# DSN server (rahasia) -> dipakai sentry.server.config.ts & sentry.edge.config.ts
SENTRY_DSN=""
# Untuk upload sourcemap saat build (opsional):
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
