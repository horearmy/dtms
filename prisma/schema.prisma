generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  keyHash   String    @unique
  keyPrefix String
  scopes    String[]
  active    Boolean   @default(true)
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String
  oldData   String?
  newData   String?
  createdAt DateTime @default(now())
  ip        String?
  method    String?
  path      String?
  userAgent String?
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([module])
  @@index([tenantId])
  @@index([userId])
}

model Branch {
  id             String        @id @default(cuid())
  tenantId       String
  companyId      String?
  name           String
  code           String?
  address        String?
  city           String?
  postalCode     String?
  phone          String?
  latitude       Float?
  longitude      Float?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String?
  regionId       String?
  company        Company?      @relation(fields: [companyId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  region         Region?       @relation(fields: [regionId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments     Department[]
  hubs            Hub[]
  users           User[]
  warehouses      Warehouse[]

  @@unique([tenantId, code])
  @@index([companyId])
  @@index([organizationId])
  @@index([regionId])
  @@index([tenantId])
}

model Company {
  id         String       @id @default(cuid())
  tenantId   String
  name       String
  code       String?
  address    String?
  city       String?
  postalCode String?
  phone      String?
  email      String?
  latitude   Float?
  longitude  Float?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime @updatedAt
  branches     Branch[]
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Customer {
  id                                     String         @id @default(cuid())
  name                                   String
  phone                                  String
  email                                  String?
  address                                String?
  city                                   String?
  postalCode                             String?
  createdAt                              DateTime       @default(now())
  latitude                               Float?
  longitude                              Float?
  tenantId                               String?
  tenant                                 Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receivedShipments Shipment[]     @relation("Shipment_receiverIdToCustomer")
  sentShipments   Shipment[]     @relation("Shipment_senderIdToCustomer")
  stops                           ShipmentStop[]

  @@index([tenantId])
}

model DailyReport {
  id               String   @id @default(cuid())
  driverId         String
  reportDate       DateTime
  deliveredCount   Int      @default(0)
  failedCount      Int      @default(0)
  rescheduledCount Int      @default(0)
  fuelLiter        Float?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  driver           Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, reportDate])
  @@index([reportDate])
}

model DeliveryAssignment {
  id         String   @id @default(cuid())
  shipmentId String
  driverId   String
  vehicleId  String?
  assignedAt DateTime @default(now())
  driver     Driver   @relation(fields: [driverId], references: [id])
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([driverId, assignedAt])
  @@index([shipmentId])
  @@index([vehicleId])
}

model DemoRequest {
  id            String    @id @default(cuid())
  name          String
  email         String
  phone         String?
  company       String
  message       String?
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  provisionedAt DateTime?
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([createdAt])
  @@index([status])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String?
  name      String
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  branchId  String?
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id])
  company   Company? @relation(fields: [companyId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([companyId])
  @@index([tenantId])
}

model Driver {
  id                 String               @id @default(cuid())
  employeeId         String               @unique
  name               String
  phone              String
  userId             String?              @unique
  status             DriverStatus         @default(ACTIVE)
  returnedAt         DateTime?
  returning          Boolean              @default(false)
  photo              String?
  returnStartedAt    DateTime?
  tenantId           String?
  dailyReports        DailyReport[]
  assignments DeliveryAssignment[]
  tenant             Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User?                @relation(fields: [userId], references: [id])
  geofenceEvents      GeofenceEvent[]
  gpsLogs             GpsLog[]

  @@index([tenantId])
}

model Exception {
  id          String            @id @default(cuid())
  tenantId    String
  shipmentId  String?
  type        ExceptionType
  severity    ExceptionSeverity @default(MEDIUM)
  status      ExceptionStatus   @default(OPEN)
  title       String
  description String?
  ownerId     String?
  dueAt       DateTime?
  resolvedAt  DateTime?
  resolution  String?
  createdBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime @updatedAt
  owner        User?             @relation(fields: [ownerId], references: [id])
  shipment    Shipment?         @relation(fields: [shipmentId], references: [id])
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([severity])
  @@index([shipmentId])
  @@index([status])
  @@index([tenantId])
}

model Geofence {
  id            String          @id @default(cuid())
  name          String
  latitude      Float
  longitude     Float
  radiusMeters  Float           @default(500)
  type          GeofenceType    @default(OPERATIONAL_AREA)
  description   String?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  tenantId      String?
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events              GeofenceEvent[]

  @@index([tenantId])
}

model GeofenceEvent {
  id         String            @id @default(cuid())
  geofenceId String
  driverId   String
  shipmentId String?
  eventType  GeofenceEventType
  latitude   Float
  longitude  Float
  createdAt  DateTime          @default(now())
  driver     Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  geofence   Geofence          @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@index([geofenceId, driverId])
}

model GpsLog {
  id        String   @id @default(cuid())
  driverId  String
  vehicleId String?
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  accuracy  Float?
  battery   Float?
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([createdAt])
  @@index([driverId, createdAt])
  @@index([vehicleId])
}

model JobQueue {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      String    @default("pending")
  attempt     Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([status, runAfter, createdAt])
}

model Hub {
  id           String   @id @default(cuid())
  tenantId     String
  branchId     String
  name         String
  code         String?
  address      String?
  city         String?
  latitude     Float?
  longitude    Float?
  radiusMeters Float    @default(500)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([branchId])
  @@index([tenantId])
}

model IntegrationConfig {
  id                  String                @id @default(cuid())
  tenantId            String
  name                String
  type                IntegrationType
  baseUrl             String?
  active              Boolean               @default(true)
  config              Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs      IntegrationLog[]
  webhooks WebhookSubscription[]

  @@index([tenantId])
}

model IntegrationLog {
  id                String            @id @default(cuid())
  integrationId     String
  direction         String
  method            String?
  path              String?
  statusCode        Int?
  request           Json?
  response          Json?
  error             String?
  durationMs        Int?
  createdAt         DateTime          @default(now())
  integrationConfig IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
}

model Invoice {
  id                 String       @id @default(cuid())
  tenantId           String
  subscriptionId     String
  invoiceNumber      String       @unique
  status             String       @default("DRAFT")
  subtotal           Float        @default(0)
  discountAmount     Float        @default(0)
  tax                Float        @default(0)
  total              Float        @default(0)
  paidAmount         Float        @default(0)
  periodKey          String       @default("")
  issuedAt           DateTime?
  currency           String       @default("IDR")
  dueDate            DateTime
  paidAt             DateTime?
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  lineItems          Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  subscription       Subscription @relation(fields: [subscriptionId], references: [id])
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments           Payment[]

  @@unique([subscriptionId, periodKey])
  @@index([status])
  @@index([tenantId])
}

model Contract {
  id               String    @id @default(cuid())
  tenantId         String
  contractNumber   String    @unique
  planCode         String?
  startDate        DateTime
  endDate          DateTime?
  billingCycle     String    @default("MONTHLY")
  paymentTermsDays Int       @default(14)
  autoRenew        Boolean   @default(true)
  creditLimit      Float     @default(0)
  gracePeriodDays  Int       @default(14)
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model PriceComponent {
  id            String    @id @default(cuid())
  planId        String
  code          String
  name          String
  chargeType    String    @default("FIXED")
  unit          String?
  unitPrice     Float     @default(0)
  minQuantity   Float     @default(0)
  maxQuantity   Float?
  taxable       Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  plan          Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, code])
  @@index([planId])
}

model BillingRun {
  id            String    @id @default(cuid())
  periodStart   DateTime
  periodEnd     DateTime
  periodKey     String
  runType       String    @default("MANUAL")
  status        String    @default("PENDING")
  startedAt     DateTime?
  completedAt   DateTime?
  totalTenants  Int       @default(0)
  totalInvoices Int       @default(0)
  totalAmount   Float     @default(0)
  errorCount    Int       @default(0)
  triggeredBy   String?
  createdAt     DateTime  @default(now())

  @@unique([periodKey, runType])
  @@index([status])
}

model TaxRule {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  rate          Float
  country       String    @default("ID")
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([username, createdAt])
}

model Message {
  id         String   @id @default(cuid())
  tenantId   String
  threadId   String?
  subject    String
  body       String
  senderId   String?
  senderName String   @default("System")
  direction  String   @default("OUTBOUND")
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([threadId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String?
  shipmentId String?
  message    String
  status     String    @default("UNREAD")
  createdAt  DateTime  @default(now())
  metadata   Json?
  tenantId   String?
  title      String?
  type       String    @default("INFO")
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model Organization {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  description String?
  logoUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branches      Branch[]
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  regions      Region[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([token])
  @@index([userId])
}

model Payment {
  id        String    @id @default(cuid())
  tenantId  String
  invoiceId String
  amount    Float
  currency  String    @default("IDR")
  method    String?
  reference String?
  status    String    @default("PENDING")
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt
  invoice   Invoice   @relation(fields: [invoiceId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Permission {
  id             String           @id @default(cuid())
  code           String           @unique
  resource       String
  action         String
  label          String?
  createdAt      DateTime         @default(now())
  rolePermissions RolePermission[]

  @@index([resource])
}

model Plan {
  id                String         @id @default(cuid())
  name              String
  code              String         @unique
  description       String?
  priceMonthly      Float          @default(0)
  priceYearly       Float          @default(0)
  currency          String         @default("IDR")
  maxUsers          Int            @default(5)
  maxDrivers        Int            @default(10)
  maxShipments      Int            @default(100)
  maxStorageMb      Int            @default(100)
  features          Json?
  active            Boolean        @default(true)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime @updatedAt
  maxApiCallsPerMin Int            @default(0)
  maxBranches       Int            @default(1)
  maxHubs           Int            @default(0)
  maxOrganizations  Int            @default(1)
  maxVehicles       Int            @default(-1)
  trialDays         Int            @default(0)
  subscriptions      Subscription[]
  priceComponents    PriceComponent[]
}

model PlanAddon {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  priceMonthly Float         @default(0)
  features     Json?
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  tenantAddons  TenantAddon[]
}

model ProofOfDelivery {
  id           String   @id @default(cuid())
  shipmentId   String
  receiverName String
  signature    String?
  photo        String?
  latitude     Float?
  longitude    Float?
  notes        String?
  deliveredAt  DateTime @default(now())
  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Region {
  id             String        @id @default(cuid())
  tenantId       String
  organizationId String?
  name           String
  code           String?
  description    String?
  latitude       Float?
  longitude      Float?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime @updatedAt
  branches         Branch[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([organizationId])
  @@index([tenantId])
}

model RolePermission {
  id           String     @id @default(cuid())
  permissionId String
  role         Role
  tenantId     String?
  branchId     String?
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([permissionId, role, tenantId])
  @@index([role])
  @@index([tenantId])
}

model Shipment {
  id                                     String               @id @default(cuid())
  trackingNumber                         String               @unique
  senderId                               String
  receiverId                             String
  origin                                 String
  destination                            String
  weight                                 Float
  volume                                 Float?
  serviceType                            ServiceType          @default(REGULAR)
  status                                 ShipmentStatus       @default(ORDER_CREATED)
  fragile                                Boolean              @default(false)
  itemName                               String?
  itemCount                              Int                  @default(1)
  itemCategory                           String?
  itemValue                              Float?
  deliveryTarget                         DateTime?
  createdAt                              DateTime             @default(now())
  updatedAt                              DateTime @updatedAt
  destLat                                Float?
  destLng                                Float?
  originLat                              Float?
  originLng                              Float?
  slaDeadline                            DateTime?
  tenantId                               String?
  assignments                     DeliveryAssignment[]
  exceptions                              Exception[]
  notifications                           Notification[]
  pods                        ProofOfDelivery[]
  receiver Customer             @relation("Shipment_receiverIdToCustomer", fields: [receiverId], references: [id])
  sender   Customer             @relation("Shipment_senderIdToCustomer", fields: [senderId], references: [id])
  tenant                                 Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipmentEvents                          ShipmentEvent[]
  items                           ShipmentItem[]
  stops                           ShipmentStop[]
  slaEvents                               SlaEvent[]
  events                          TrackingEvent[]
  scans                          WarehouseScan[]

  @@index([createdAt])
  @@index([receiverId])
  @@index([senderId])
  @@index([status])
  @@index([tenantId])
}

model ShipmentEvent {
  id             String            @id @default(cuid())
  tenantId       String?
  shipmentId     String
  eventType      ShipmentEventType
  previousStatus ShipmentStatus?
  newStatus      ShipmentStatus?
  actorType      String?
  actorId        String?
  metadata       String?
  latitude       Float?
  longitude      Float?
  occurredAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())
  shipment       Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  tenant         Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([shipmentId])
  @@index([tenantId])
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  itemName   String
  quantity   Int
  weight     Float?
  dimension  String?
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ShipmentStop {
  id         String    @id @default(cuid())
  shipmentId String
  seq        Int
  customerId String?
  label      String
  address    String?
  city       String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  customer   Customer? @relation(fields: [customerId], references: [id])
  shipment   Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model SlaEvent {
  id         String     @id @default(cuid())
  tenantId   String
  shipmentId String
  policyId   String?
  status     String     @default("ON_TRACK")
  deadline   DateTime
  breachedAt DateTime?
  createdAt  DateTime   @default(now())
  slaPolicy  SlaPolicy? @relation(fields: [policyId], references: [id])
  shipment   Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([status])
  @@index([tenantId])
}

model SlaPolicy {
  id          String      @id @default(cuid())
  tenantId    String
  name        String
  serviceType ServiceType @default(REGULAR)
  originCity  String?
  destCity    String?
  priority    Int         @default(0)
  targetHours Int
  cutoffTime  String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime @updatedAt
  slaEvents    SlaEvent[]
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, serviceType])
}

model Subscription {
  id                 String        @id @default(cuid())
  tenantId           String        @unique
  planId             String
  status             String        @default("ACTIVE")
  billingCycle       String        @default("MONTHLY")
  startDate          DateTime      @default(now())
  currentPeriodStart DateTime      @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime @updatedAt
  invoices            Invoice[]
  plan               Plan          @relation(fields: [planId], references: [id])
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usageRecords        UsageRecord[]
}

model Tenant {
  id                  String                @id @default(cuid())
  name                String
  slug                String                @unique
  logoUrl             String?
  faviconUrl          String?
  primaryColor        String                @default("#2563eb")
  secondaryColor      String                @default("#1e40af")
  accentColor         String                @default("#3b82f6")
  domain              String?               @unique
  plan                String                @default("FREE")
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  maxUsers            Int                   @default(5)
  maxDrivers          Int                   @default(10)
  maxShipments        Int                   @default(100)
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime @updatedAt
  code                String?               @unique
  currency            String                @default("IDR")
  locale              String                @default("id-ID")
  status              TenantStatus          @default(ACTIVE)
  timezone            String                @default("Asia/Jakarta")
  maxBranches         Int                   @default(1)
  maxHubs             Int                   @default(0)
  maxOrganizations    Int                   @default(1)
  maxVehicles         Int                   @default(-1)
  maxStorageMb        Int                   @default(50)
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  branches              Branch[]
  companies             Company[]
  customers            Customer[]
  demoRequests         DemoRequest[]
  departments          Department[]
  drivers              Driver[]
  exceptions           Exception[]
  geofences            Geofence[]
  hubs                 Hub[]
  integrationConfigs   IntegrationConfig[]
  invoices             Invoice[]
  messages             Message[]
  notifications        Notification[]
  organizations        Organization[]
  payments             Payment[]
  regions              Region[]
  rolePermissions      RolePermission[]
  shipments            Shipment[]
  shipmentEvents       ShipmentEvent[]
  slaEvents            SlaEvent[]
  slaPolicies           SlaPolicy[]
  subscription        Subscription?
  contracts           Contract[]
  tenantAddons         TenantAddon[]
  tenantHealthMetrics  TenantHealthMetric[]
  tenantOnboardings    TenantOnboarding[]
  rateLimit     TenantRateLimit?
  uploadedFiles        UploadedFile[]
  usageRecords         UsageRecord[]
  users                User[]
  vehicles             Vehicle[]
  warehouses           Warehouse[]
  webhookSubscriptions WebhookSubscription[]
  whiteLabel          WhiteLabel?

  @@index([code])
  @@index([domain])
  @@index([slug])
  @@index([status])
}

model TenantAddon {
  id        String    @id @default(cuid())
  tenantId  String
  addonId   String
  quantity  Int       @default(1)
  startDate DateTime  @default(now())
  endDate   DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  addon PlanAddon @relation(fields: [addonId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, addonId])
  @@index([tenantId])
}

model TenantHealthMetric {
  id         String   @id @default(cuid())
  tenantId   String
  metricType String
  value      Float
  unit       String?
  period     String?
  recordedAt DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, metricType])
  @@index([tenantId, metricType, recordedAt])
}

model TenantOnboarding {
  id          String           @id @default(cuid())
  tenantId    String
  step        String
  label       String
  description String?
  status      OnboardingStatus @default(PENDING)
  order       Int              @default(0)
  completedAt DateTime?
  data        Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, step])
  @@index([tenantId])
}

model TenantRateLimit {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  apiMaxRequests Int      @default(300)
  apiWindowMs    Int      @default(60000)
  gpsMaxRequests Int      @default(60)
  gpsWindowMs    Int      @default(60000)
  active         Boolean  @default(true)
  blocked        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TrackingEvent {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  latitude   Float?
  longitude  Float?
  notes      String?
  createdBy  String?
  createdAt  DateTime       @default(now())
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model UploadedFile {
  id           String   @id @default(cuid())
  tenantId     String?
  objectKey    String   @unique
  fileName     String
  mimeType     String
  size         Int
  checksum     String?
  uploadedById String?
  category     String   @default("general")
  shipmentId   String?
  createdAt    DateTime @default(now())
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([objectKey])
  @@index([shipmentId])
  @@index([tenantId])
}

model UsageRecord {
  id             String       @id @default(cuid())
  tenantId       String
  subscriptionId String
  metric         String
  quantity       Int          @default(0)
  recordedAt     DateTime     @default(now())
  periodStart    DateTime
  periodEnd      DateTime
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId, metric])
}

model User {
  id                 String               @id @default(cuid())
  name               String
  username           String
  passwordHash       String
  role               Role
  status             UserStatus           @default(ACTIVE)
  phone              String?
  createdAt          DateTime             @default(now())
  lastPasswordChange DateTime?
  mustChangePassword Boolean              @default(false)
  pwdVersion         Int                  @default(1)
  backupCodes        String?
  email              String?
  provider           String               @default("LOCAL")
  totpEnabled        Boolean              @default(false)
  totpSecret         String?
  tenantId           String?
  branchId           String?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  auditLogs           AuditLog[]
  driver             Driver?
  exceptions          Exception[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  branch             Branch?              @relation(fields: [branchId], references: [id])
  tenant             Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, username])
  @@index([branchId])
  @@index([tenantId])
}

model Vehicle {
  id                 String               @id @default(cuid())
  vehicleNumber      String               @unique
  type               String
  capacity           Float                @default(0)
  status             String               @default("AVAILABLE")
  photoBack          String?
  photoFront         String?
  photoLeft          String?
  photoRight         String?
  totalDistanceKm    Float                @default(0)
  returnedAt         DateTime?
  returning          Boolean              @default(false)
  tenantId           String?
  assignments DeliveryAssignment[]
  gpsLogs             GpsLog[]
  tenant             Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenanceRecords VehicleMaintenance[]

  @@index([tenantId])
}

model VehicleMaintenance {
  id          String   @id @default(cuid())
  vehicleId   String
  type        String
  description String?
  cost        Float?
  odometerKm  Float?
  notes       String?
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, performedAt])
}

model Warehouse {
  id           String   @id @default(cuid())
  tenantId     String
  branchId     String?
  name         String
  code         String?
  address      String?
  city         String?
  latitude     Float?
  longitude    Float?
  radiusMeters Float    @default(500)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  branch       Branch?  @relation(fields: [branchId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([branchId])
  @@index([tenantId])
}

model WarehouseScan {
  id         String   @id @default(cuid())
  shipmentId String
  action     String
  scannedBy  String?
  latitude   Float?
  longitude  Float?
  notes      String?
  createdAt  DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model WebhookDelivery {
  id                  String              @id @default(cuid())
  subscriptionId      String
  event               String
  payload             Json
  statusCode          Int?
  responseBody        String?
  attempt             Int                 @default(0)
  maxAttempts         Int                 @default(3)
  status              String              @default("PENDING")
  nextRetryAt         DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime            @default(now())
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([subscriptionId])
}

model WebhookSubscription {
  id                String             @id @default(cuid())
  tenantId          String
  integrationId     String?
  url               String
  events            String[]
  secret            String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  deliveries   WebhookDelivery[]
  integrationConfig IntegrationConfig? @relation(fields: [integrationId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model WhiteLabel {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  appName          String?
  logoUrl          String?
  faviconUrl       String?
  primaryColor     String?
  secondaryColor   String?
  accentColor      String?
  loginBgUrl       String?
  emailFromName    String?
  emailFromAddress String?
  emailTemplate    Json?
  smsProvider      String?
  smsConfig        Json?
  customCss        String?
  customDomain     String?
  landingPageHtml  String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

