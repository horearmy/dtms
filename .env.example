# ===== DTMS Environment Variables =====
# Salin file ini menjadi `.env` lalu isi nilainya.

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL="postgresql://dtms:PASSWORD@localhost:5432/dtms"

# --- Keamanan / Auth ---
# Secret untuk menandatangani JWT. WAJIB diubah menjadi string acak panjang.
AUTH_SECRET="ganti-dengan-secret-acak-panjang"

# Durasi sesi login dalam jam (opsional, default 12).
SESSION_HOURS="12"

# Admin awal (dibuat otomatis saat seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-admin-password"

# --- SSO Google (opsional) ---
# Buat OAuth Client ID di Google Cloud Console
# (https://console.cloud.google.com/apis/credentials) lalu isi:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Harus konsisten dgn redirect URI yang didaftarkan:
#   {APP_URL}/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# URL publik aplikasi, contoh: https://dtms.example.com (tanpa slash di akhir)
APP_URL=""

# --- WhatsApp Business API (opsional) ---
# Ambil dari Meta Business Suite > WhatsApp > Getting Started
# https://business.facebook.com/wa/manage/message-templates/
WHATSAPP_ENABLED="false"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Nomor tujuan notifikasi admin (format: 62xxxxxxxxxx, pisahkan koma jika lebih dari satu)
WHATSAPP_ADMIN_NUMBERS=""

# --- Observability Sentry (opsional) ---
# DSN publik (ekspos di client) -> dipakai sentry.client.config.ts
NEXT_PUBLIC_SENTRY_DSN=""
# DSN server (rahasia) -> dipakai sentry.server.config.ts & sentry.edge.config.ts
SENTRY_DSN=""
# Untuk upload sourcemap saat build (opsional):
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Health Check (opsional) ---
# API key untuk endpoint /api/health/dashboard. Jika kosong, fallback ke SUPERADMIN_SECRET_KEY.
HEALTH_API_KEY=""

# --- Rate Limiting (opsional) ---
# Batas login per menit per IP (default: 10). Hanya ubah untuk testing!
# RATE_LOGIN_LIMIT="10"
# Batas percobaan gagal per username sebelum lockout (default: 5)
# MAX_LOGIN_ATTEMPTS="5"
# Batas percobaan gagal per IP sebelum lockout (default: 20)
# MAX_IP_FAILURES="20"
# Batas API request per menit per tenant (default: 60)
# RATE_API_LIMIT="60"
# Batas GPS request per menit per tenant (default: 30)
# RATE_GPS_LIMIT="30"
# Set true di production agar rate limiting gagal tertutup jika Redis tidak tersedia.
# RATE_LIMIT_REQUIRE_REDIS="true"
